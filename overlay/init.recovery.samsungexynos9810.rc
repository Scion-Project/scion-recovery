# Scion recovery. TWRP's init.rc already imports /init.recovery.${ro.hardware}.rc
# (ro.hardware is samsungexynos9810 on the S9) and stock TWRP ships no such file,
# so this adds to TWRP without editing any of its files.
#
# One oneshot service, declared exactly like TWRP's own set_permissive: class
# default, started by "class_start default" on boot. init does not wait for it,
# and if it fails, nothing else is affected.
service scion_bootlogs /sbin/scion-bootlogs
    oneshot
    seclabel u:r:recovery:s0
