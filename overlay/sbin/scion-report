#!/sbin/sh
# SPDX-License-Identifier: MIT-0
# scion-report: the crash report Scion may send, and the scrubber every log
# goes through first. Nothing here sends anything; sending is a separate,
# opt-in step. POSIX sh and awk only: it runs in TWRP's busybox on the phone and
# with any awk on a computer, for the tests.
#
#   scion-report build <console-log> <out.json>   the report (JSON, scrubbed)
#   scion-report scrub < in > out                 the scrubber alone
#
# build keeps only the kernel console lines that matter for a crash (CRASH,
# SWEET EXIT, panic(, STARLTE TOP/MEM, decmpfs, MTL2 refusals, cpufreq_gov
# stats), scrubs them, keeps the first 2000, and writes:
#   {"install_id", "model", "builds": {"recovery"}, "ts", "lines": [...]}
#
# Environment: SCION_CACHE_DIR (default /cache/scion: install-id lives there),
# SCION_AWK (the awk to run, default awk).
set -eu
LC_ALL=C
export LC_ALL

# mksh writes here-documents to $TMPDIR: adb's shell sets one that recovery does not have.
[ -d "${TMPDIR:-/nonexistent}" ] || TMPDIR=/tmp
export TMPDIR
AWK=${SCION_AWK:-awk}
CACHE=${SCION_CACHE_DIR:-/cache/scion}

die() { echo "scion-report: $*" >&2; exit 1; }
usage() {
	echo "usage: scion-report build <console-log> <out.json>" >&2
	echo "       scion-report scrub < in > out" >&2
	exit 2
}

# The awk program. Portable awk only: no {n} intervals, no gensub, no \d.
# mode=scrub: scrub stdin lines. mode=json: scrub the report lines of stdin, as
# JSON array items. mode=esc: JSON-escape each input line.
awkprog() {
	cat <<'AWK_PROG'
function ci(w,   r, i, c) {
	r = ""
	for (i = 1; i <= length(w); i++) {
		c = substr(w, i, 1)
		if (c ~ /[A-Za-z]/) r = r "[" toupper(c) tolower(c) "]"
		else r = r c
	}
	return r
}

function hx(n,   r, i) {
	r = ""
	for (i = 0; i < n; i++) r = r "[0-9A-Fa-f]"
	return r
}

function esc(s,   out, i, c) {
	out = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (c == "\\") out = out "\\\\"
		else if (c == Q) out = out "\\" Q
		else if (ORD[c] == 9) out = out "\\t"
		else if (ORD[c] == 10) out = out "\\n"
		else if (ORD[c] == 12) out = out "\\f"
		else if (ORD[c] == 13) out = out "\\r"
		else if (ORD[c] == 8) out = out "\\b"
		else if (ORD[c] < 32) out = out sprintf("\\u%04x", ORD[c])
		else out = out c
	}
	return out
}

# Is a regex match really the thing to replace? Checked after the regex matched.
function valid(kind, m,   i, n) {
	if (kind == "ipv4") {
		n = split(m, a, ".")
		if (n != 4) return 0
		for (i = 1; i <= 4; i++) if (a[i] + 0 > 255) return 0
		return 1
	}
	if (kind == "ip6") {
		n = 0
		for (i = 1; i <= length(m); i++) if (substr(m, i, 1) == ":") n++
		if (n < 2) return 0
		if (index(m, "::") > 0) return 1
		return n == 7
	}
	if (kind == "phone") return length(m) >= 10 && length(m) <= 16
	if (kind == "hex") return length(m) > 24
	if (kind == "num15") return length(m) == 15
	return 1
}

# Replace each regex match that passes valid(); the rest is copied unchanged.
function scrub_re(s, re, rep, kind,   out, i, m) {
	out = ""
	while ((i = match(s, re)) > 0) {
		m = substr(s, i, RLENGTH)
		out = out substr(s, 1, i - 1)
		if (valid(kind, m)) out = out rep
		else out = out m
		s = substr(s, i + RLENGTH)
	}
	return out s
}

# key=value, key: value, key value for the serial-like keys: the value goes.
# The keyword must not be part of a longer word.
function scrub_keys(s,   out, i, m, k) {
	out = ""
	while ((i = match(s, KEYRE)) > 0) {
		m = substr(s, i, RLENGTH)
		out = out substr(s, 1, i - 1)
		if (i > 1 && substr(s, i - 1, 1) ~ /[A-Za-z0-9_]/) out = out m
		else {
			k = m
			sub(/[=: ].*$/, "", k)
			out = out k "=<redacted>"
		}
		s = substr(s, i + RLENGTH)
	}
	return out s
}

# ssid / bssid / network / connected to: the rest of the field (up to a comma,
# a semicolon or a tab) is the network's name. The keyword is kept.
function scrub_ssid(s,   out, p, kl, rest, sep, cut) {
	out = ""
	while ((p = match(s, SSIDRE)) > 0) {
		kl = RLENGTH
		out = out substr(s, 1, p + kl - 1)
		rest = substr(s, p + kl)
		sep = ""
		if (match(rest, /^[=: ]+/)) {
			sep = substr(rest, 1, RLENGTH)
			rest = substr(rest, RLENGTH + 1)
		}
		if (sep == "") { s = rest; continue }
		if (rest == "") { out = out sep; s = ""; break }
		cut = match(rest, /[,;\t]/)
		if (cut > 0) s = substr(rest, cut)
		else s = ""
		out = out sep "<ssid>"
		if (s == "") break
	}
	return out s
}

function scrub_line(s) {
	DROP = 0
	if (s ~ DROPRE) { DROP = 1; return "" }
	gsub(/[\200-\377]/, "?", s)
	gsub("/Users/[^/ \t]+/", "/Users/<user>/", s)
	gsub("/var/mobile/Containers/Data/Application/[0-9A-Fa-f-]+", "/var/mobile/Containers/Data/Application/<uuid>", s)
	gsub(EMAILRE, "<email>", s)
	s = scrub_ssid(s)
	gsub(JOINRE, "join <ssid>", s)
	s = scrub_keys(s)
	s = scrub_re(s, MACRE, "<mac>", "any")
	gsub(UUIDRE, "<uuid>", s)
	gsub(GEORE, "<geo>", s)
	s = scrub_re(s, "[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+", "<ip>", "ipv4")
	s = scrub_re(s, "[0-9A-Fa-f:]+", "<ip6>", "ip6")
	s = scrub_re(s, "[+][0-9]+", "<phone>", "phone")
	s = scrub_re(s, "[0-9A-Fa-f][0-9A-Fa-f]*", "<hex>", "hex")
	s = scrub_re(s, "[0-9][0-9]*", "<num15>", "num15")
	return s
}

BEGIN {
	Q = sprintf("%c", 34)
	for (i = 1; i < 256; i++) ORD[sprintf("%c", i)] = i
	CAP = 2000
	kept = 0
	DROPRE = "(" ci("serial-number") "|" ci("mlb-serial") "|" ci("region-info") "|" ci("model-number") "|" ci("unique-chip-id") "|" ci("ecid") "|" ci("nonce") ")"
	SSIDRE = "(" ci("ssid") "|" ci("bssid") "|" ci("network") "|" ci("connected to") ")"
	KEYRE = "(" ci("serialno") "|" ci("serial") "|" ci("sn") "|" ci("imei") "|" ci("meid") "|" ci("iccid") "|" ci("udid") "|" ci("ecid") ")[=: ]+[^ \t,;]+"
	JOINRE = ci("join") "[ ]+(" Q "[^" Q "]*" Q "|'[^']*')"
	EMAILRE = "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z][A-Za-z]+"
	MACRE = hx(2) ":" hx(2) ":" hx(2) ":" hx(2) ":" hx(2) ":" hx(2)
	UUIDRE = hx(8) "-" hx(4) "-" hx(4) "-" hx(4) "-" hx(12)
	GEORE = "-?[0-9]+[.][0-9][0-9][0-9][0-9]+,[ ]*-?[0-9]+[.][0-9][0-9][0-9][0-9]+"
	EXTRACT = "CRASH|SWEET EXIT|panic[(]|STARLTE TOP|STARLTE MEM|decmpfs|MTL2.*(refused|Unsupported)|cpufreq_gov:.*stat"
}

{
	if (mode == "esc") { print esc($0); next }
	if (mode == "scrub") {
		r = scrub_line($0)
		if (!DROP) print r
		next
	}
	if ($0 !~ EXTRACT) next
	r = scrub_line($0)
	if (DROP) next
	if (kept >= CAP) exit
	if (kept > 0) printf ",\n"
	printf "    \"%s\"", esc(r)
	kept++
}

END {
	if (mode == "json" && kept > 0) printf "\n"
}
AWK_PROG
}

prop() {
	if command -v getprop >/dev/null 2>&1; then
		getprop "$1" 2>/dev/null | head -n 1 | tr -d '\r'
	fi
	return 0
}

jesc() { printf '%s\n' "$1" | "$AWK" -v mode=esc "$(awkprog)"; }

scrub() {
	tr -d '\000' | "$AWK" -v mode=scrub "$(awkprog)"
}

# The install-id: a random 32-hex string made once and kept in $CACHE.
install_id() {
	f=$CACHE/install-id
	if [ -s "$f" ]; then
		head -n 1 "$f" | tr -d '\r'
		return 0
	fi
	h=$(head -c 16 /dev/urandom | od -An -tx1 2>/dev/null | tr -d ' \n')
	# TWRP's busybox od has no -A/-t: its hexdump does the same.
	[ "${#h}" -eq 32 ] || h=$(head -c 16 /dev/urandom | hexdump -v -e '/1 "%02x"' 2>/dev/null)
	[ "${#h}" -eq 32 ] || die "no random source for the install-id"
	if mkdir -p "$CACHE" 2>/dev/null && printf '%s\n' "$h" > "$f" 2>/dev/null; then
		:
	else
		echo "scion-report: cannot keep $f; this install-id is not stored" >&2
	fi
	printf '%s\n' "$h"
}

build() {
	[ $# -eq 2 ] || usage
	log=$1
	out=$2
	[ -r "$log" ] || die "cannot read $log"
	id=$(install_id)
	model=$(prop ro.product.model)
	[ -n "$model" ] || model=unknown
	rec=$(prop ro.scion.version)
	[ -n "$rec" ] || rec=unknown
	ts=$(date +%s)
	tmp=$out.tmp.$$
	if ! {
		printf '{\n'
		printf '  "install_id": "%s",\n' "$(jesc "$id")"
		printf '  "model": "%s",\n' "$(jesc "$model")"
		printf '  "builds": {"recovery": "%s"},\n' "$(jesc "$rec")"
		printf '  "ts": %s,\n' "$ts"
		printf '  "lines": [\n'
		tr -d '\000' < "$log" | "$AWK" -v mode=json "$(awkprog)"
		printf '  ]\n}\n'
	} > "$tmp"; then
		rm -f "$tmp"
		die "cannot write $out"
	fi
	mv "$tmp" "$out"
}

case ${1:-} in
build)
	shift
	build "$@"
	;;
scrub)
	[ $# -eq 1 ] || usage
	scrub
	;;
*)
	usage
	;;
esac
