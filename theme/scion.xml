<?xml version="1.0"?>
<!-- SPDX-License-Identifier: MIT-0 -->
<!-- Scion recovery's pages for TWRP 3.7.0's GUI. ui.xml includes this file
     after portrait.xml (scripts/theme.py adds the include), so every style,
     template and variable of the stock theme is available here. TeamWin's own
     home page is still there as "twrp_home"; "main2" (the page TWRP returns to
     on Home) is Scion's.

     Every Scion action runs /sbin/scion through TWRP's terminalcommand action,
     whose output goes to the console on the page; the script ends with a line
     "scion: RESULT: OK" or "scion: RESULT: FAILED ...". terminalcommand does not
     report the command's exit status to the GUI, so scion_done shows the log
     rather than TWRP's "Successful"/"Failed".

     Coordinates are in TWRP's 1080x1920 design space; TWRP scales them to the
     S9's 1440x2960 panel. The <variables> block below is moved into ui.xml's
     by theme.py. scripts/theme.py lint checks it: well-formed, every page,
     style, template, resource and variable it names exists, every line fits
     the screen in TWRP's font (TWRP does not wrap text), every page has a
     home key, and no page erases or restores. -->
<recovery>
	<variables>
		<variable name="scion_section1_y" value="276"/>
		<variable name="scion_btn_row1_y" value="330"/>
		<variable name="scion_btn_row2_y" value="530"/>
		<variable name="scion_btn_row3_y" value="730"/>
		<variable name="scion_btn_row4_y" value="930"/>
		<variable name="scion_section2_y" value="1150"/>
		<variable name="scion_twrp_row1_y" value="1210"/>
		<variable name="scion_twrp_row2_y" value="1360"/>
		<variable name="scion_footer_y" value="1560"/>
		<variable name="scion_list_y" value="300"/>
		<variable name="scion_list_h" value="1000"/>
		<variable name="scion_note_y" value="1340"/>
		<variable name="scion_note1_y" value="1340"/>
		<variable name="scion_note2_y" value="1390"/>
		<variable name="scion_list2_y" value="420"/>
		<variable name="scion_list2_h" value="880"/>
		<variable name="scion_fb_list_h" value="340"/>
		<variable name="scion_fb_text1_y" value="720"/>
		<variable name="scion_fb_text2_y" value="780"/>
		<variable name="scion_fb_text3_y" value="840"/>
		<variable name="scion_fb_text4_y" value="920"/>
		<variable name="tw_scion_advanced" value="0"/>
		<variable name="tw_scion_pick" value="write"/>
		<!-- MTP off at start: it fails here ("Failed to start usb driver") and Scion uses adb. -->
		<variable name="tw_mtp_enabled" value="0" persist="1"/>
	</variables>

	<pages>
		<page name="main2">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>Scion recovery</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>Galaxy S9 · TWRP %tw_version%</text>
			</text>

			<text style="text_m_accent">
				<placement x="%indent%" y="%scion_section1_y%"/>
				<text>Scion</text>
			</text>

			<button style="main_button_half_height">
				<placement x="%indent%" y="%scion_btn_row1_y%"/>
				<text>Install iOS</text>
				<action function="page">scion_install</action>
			</button>

			<button style="main_button_half_height">
				<placement x="%center_x%" y="%scion_btn_row1_y%"/>
				<text>Switch system</text>
				<action function="page">scion_switch</action>
			</button>

			<button style="main_button_half_height">
				<placement x="%indent%" y="%scion_btn_row2_y%"/>
				<text>Back up</text>
				<action function="page">scion_backup</action>
			</button>

			<button style="main_button_half_height">
				<placement x="%center_x%" y="%scion_btn_row2_y%"/>
				<text>Save logs</text>
				<action function="page">scion_logs</action>
			</button>

			<button style="main_button_half_height">
				<placement x="%indent%" y="%scion_btn_row3_y%"/>
				<text>iOS disks</text>
				<action function="page">scion_disks</action>
			</button>

			<button style="main_button_half_height">
				<placement x="%center_x%" y="%scion_btn_row3_y%"/>
				<text>Phone info</text>
				<actions>
					<action function="set">tw_back=main2</action>
					<action function="set">tw_action_text1=Phone info</action>
					<action function="set">tw_action_param=/sbin/scion facts</action>
					<action function="page">scion_go</action>
				</actions>
			</button>

			<button style="main_button_half_height">
				<placement x="%indent%" y="%scion_btn_row4_y%"/>
				<text>Fastboot</text>
				<action function="page">scion_fastboot</action>
			</button>

			<button style="main_button_half_height">
				<placement x="%center_x%" y="%scion_btn_row4_y%"/>
				<text>Scion settings</text>
				<action function="page">scion_settings</action>
			</button>

			<text style="text_m_accent">
				<placement x="%indent%" y="%scion_section2_y%"/>
				<text>TWRP</text>
			</text>

			<button style="button_quarter_width">
				<placement x="%indent%" y="%scion_twrp_row1_y%"/>
				<text>{@install_btn=Install}</text>
				<actions>
					<action function="queueclear"/>
					<action function="set">tw_selectimage=0</action>
					<action function="page">install</action>
				</actions>
			</button>

			<button style="button_quarter_width">
				<placement x="%btn4_col2_x%" y="%scion_twrp_row1_y%"/>
				<text>{@backup_btn=Backup}</text>
				<action function="page">backup</action>
			</button>

			<button style="button_quarter_width">
				<placement x="%btn4_col3_x%" y="%scion_twrp_row1_y%"/>
				<text>{@mount_btn=Mount}</text>
				<action function="page">mount</action>
			</button>

			<button style="button_quarter_width">
				<placement x="%btn4_col4_x%" y="%scion_twrp_row1_y%"/>
				<text>{@settings_btn=Settings}</text>
				<action function="page">settings</action>
			</button>

			<button style="button_quarter_width">
				<placement x="%indent%" y="%scion_twrp_row2_y%"/>
				<text>{@advanced_btn=Advanced}</text>
				<action function="page">advanced</action>
			</button>

			<button style="button_quarter_width">
				<placement x="%btn4_col2_x%" y="%scion_twrp_row2_y%"/>
				<text>{@reboot_btn=Reboot}</text>
				<action function="page">reboot</action>
			</button>

			<text style="text_s">
				<placement x="%center_x%" y="%scion_footer_y%" placement="5"/>
				<text>Scion's actions write BOOT and USERDATA only.</text>
			</text>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<!-- Entered from every Scion button: a fresh operation state, then scion_run. -->
		<page name="scion_go">
			<action>
				<action function="set">tw_operation_state=0</action>
				<action function="page">scion_run</action>
			</action>
		</page>

		<!-- Run tw_action_param (a /sbin/scion command line) with its output in the console. -->
		<page name="scion_run">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>%tw_action_text1%</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>Running...</text>
			</text>

			<template name="console"/>

			<template name="progress_bar"/>

			<action>
				<condition var1="tw_operation_state" var2="1"/>
				<action function="page">scion_done</action>
			</action>

			<action>
				<actions>
					<action function="set">tw_terminal_location=/tmp</action>
					<action function="terminalcommand">%tw_action_param%</action>
				</actions>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="scion_done">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>%tw_action_text1%</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>Done: the last line says OK or FAILED</text>
			</text>

			<template name="console"/>

			<button style="main_button_half_height">
				<placement x="%indent%" y="%row21a_y%"/>
				<text>{@back_btn=Back}</text>
				<actions>
					<action function="set">tw_clear_destination=%tw_back%</action>
					<action function="page">clear_vars</action>
				</actions>
			</button>

			<button style="main_button_half_height">
				<placement x="%center_x%" y="%row21a_y%"/>
				<text>Home</text>
				<actions>
					<action function="set">tw_clear_destination=main2</action>
					<action function="page">clear_vars</action>
				</actions>
			</button>

			<action>
				<touch key="home"/>
				<actions>
					<action function="set">tw_clear_destination=main2</action>
					<action function="page">clear_vars</action>
				</actions>
			</action>

			<action>
				<touch key="back"/>
				<actions>
					<action function="set">tw_clear_destination=%tw_back%</action>
					<action function="page">clear_vars</action>
				</actions>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<!-- A swipe before anything that writes. tw_text1..3 say what, tw_slider_text the swipe. -->
		<page name="scion_confirm">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>%tw_action_text1%</text>
			</text>

			<text style="text_m_accent">
				<placement x="%center_x%" y="%row2_y%" placement="5"/>
				<text>%tw_text1%</text>
			</text>

			<text style="text_m">
				<placement x="%center_x%" y="%row4_y%" placement="5"/>
				<text>%tw_text2%</text>
			</text>

			<text style="text_m">
				<placement x="%center_x%" y="%row6_y%" placement="5"/>
				<text>%tw_text3%</text>
			</text>

			<text style="text_m">
				<placement x="%center_x%" y="%row9_y%" placement="5"/>
				<text>{@back_cancel=Press back button to cancel.}</text>
			</text>

			<slider>
				<text>%tw_slider_text%</text>
				<action function="page">scion_go</action>
			</slider>

			<action>
				<touch key="back"/>
				<actions>
					<action function="set">tw_clear_destination=%tw_back%</action>
					<action function="page">clear_vars</action>
				</actions>
			</action>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="scion_logs">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>Save logs</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>Read only: nothing on the phone is changed</text>
			</text>

			<listbox style="advanced_listbox">
				<placement x="%indent%" y="%scion_list_y%" w="%content_width%" h="%scion_list_h%"/>

				<listitem name="Save the logs of the last run">
					<actions>
						<action function="set">tw_back=scion_logs</action>
						<action function="set">tw_action_text1=Save logs</action>
						<action function="set">tw_action_param=/sbin/scion logs</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>

				<listitem name="Copy iOS crash logs (CrashReporter)">
					<actions>
						<action function="set">tw_back=scion_logs</action>
						<action function="set">tw_action_text1=iOS crash logs</action>
						<action function="set">tw_action_param=/sbin/scion pull</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>

				<listitem name="Show the logs saved at this boot">
					<actions>
						<action function="set">tw_back=scion_logs</action>
						<action function="set">tw_action_text1=Logs of this boot</action>
						<action function="set">tw_action_param=ls -l /tmp/scion-boot /tmp/scion-boot/pstore</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
			</listbox>

			<text style="text_s">
				<placement x="%indent%" y="%scion_note_y%"/>
				<text>Logs go to /tmp (RAM): adb pull the path printed.</text>
			</text>

			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="scion_disks">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>iOS disks</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>HFS Plus and APFS, read only</text>
			</text>

			<listbox style="advanced_listbox">
				<placement x="%indent%" y="%scion_list_y%" w="%content_width%" h="%scion_list_h%"/>

				<listitem name="Mount iOS's /private/var (read only)">
					<actions>
						<action function="set">tw_back=scion_disks</action>
						<action function="set">tw_action_text1=Mount iOS var</action>
						<action function="set">tw_action_param=/sbin/scion mountvar</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>

				<listitem name="Inspect: what USERDATA and SYSTEM hold">
					<actions>
						<action function="set">tw_back=scion_disks</action>
						<action function="set">tw_action_text1=Inspect</action>
						<action function="set">tw_action_param=/sbin/scion inspect</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
				<listitem name="Check (APFS: apfsck, read only)">
					<actions>
						<action function="set">tw_back=scion_disks</action>
						<action function="set">tw_action_text1=Check</action>
						<action function="set">tw_action_param=/sbin/scion fsck</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
				<listitem name="Unmount">
					<actions>
						<action function="set">tw_back=scion_disks</action>
						<action function="set">tw_action_text1=Unmount iOS var</action>
						<action function="set">tw_action_param=/sbin/scion umountvar</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
			</listbox>

			<text style="text_s">
				<placement x="%indent%" y="%scion_note_y%"/>
				<text>Mounted at /scion/var: see Advanced > File Manager.</text>
			</text>

			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="scion_pick_root">
			<template name="page"/>

			<text style="text_l">
				<condition var1="tw_scion_pick" var2="write"/>
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>Install an iOS root</text>
			</text>

			<text style="text_l">
				<condition var1="tw_scion_pick" var2="restore"/>
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>Restore an iOS root</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>Pick the .img: it goes to USERDATA</text>
			</text>

			<template name="sort_options"/>

			<fileselector>
				<placement x="%indent%" y="%row3_y%" w="%content_width%" h="%fileselector_install_height%"/>
				<text>%tw_scion_root_location%</text>
				<filter extn=".img" folders="1" files="1"/>
				<path name="tw_scion_root_location" default="/external_sd"/>
				<data name="tw_filename"/>
				<selection name="tw_file"/>
			</fileselector>

			<button style="main_button_half_height">
				<placement x="%indent%" y="%row21a_y%"/>
				<text>{@select_storage_btn=Select Storage}</text>
				<actions>
					<action function="set">tw_back=scion_pick_root</action>
					<action function="overlay">select_storage</action>
				</actions>
			</button>

			<action>
				<conditions>
					<condition var1="tw_scion_pick" var2="write"/>
					<condition var1="tw_filename" op="modified"/>
				</conditions>
				<actions>
					<action function="set">tw_back=scion_install</action>
					<action function="set">tw_action_text1=Install iOS root</action>
					<action function="set">tw_text1=%tw_file%</action>
					<action function="set">tw_text2=ERASES USERDATA: Android's data or the iOS on it</action>
					<action function="set">tw_text3=Every 64 MiB piece is read back and compared</action>
					<action function="set">tw_slider_text=Swipe to erase and write USERDATA</action>
					<action function="set">tw_action_param=/sbin/scion write-root "%tw_filename%" --yes</action>
					<action function="page">scion_confirm</action>
				</actions>
			</action>

			<action>
				<conditions>
					<condition var1="tw_scion_pick" var2="restore"/>
					<condition var1="tw_filename" op="modified"/>
				</conditions>
				<actions>
					<action function="set">tw_back=scion_backup</action>
					<action function="set">tw_action_text1=Restore iOS root</action>
					<action function="set">tw_text1=%tw_file%</action>
					<action function="set">tw_text2=ERASES USERDATA; needs the image's .sha256</action>
					<action function="set">tw_text3=Every 64 MiB piece is read back and compared</action>
					<action function="set">tw_slider_text=Swipe to restore USERDATA</action>
					<action function="set">tw_action_param=/sbin/scion restore-root "%tw_filename%" --yes</action>
					<action function="page">scion_confirm</action>
				</actions>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="scion_boot">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>Write a boot image</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>Pick an .img: it goes to BOOT only</text>
			</text>

			<template name="sort_options"/>

			<fileselector>
				<placement x="%indent%" y="%row3_y%" w="%content_width%" h="%fileselector_install_height%"/>
				<text>%tw_zip_location%</text>
				<filter extn=".img" folders="1" files="1"/>
				<path name="tw_zip_location" default="/external_sd"/>
				<data name="tw_filename"/>
				<selection name="tw_file"/>
			</fileselector>

			<button style="main_button_half_height">
				<placement x="%indent%" y="%row21a_y%"/>
				<text>{@select_storage_btn=Select Storage}</text>
				<actions>
					<action function="set">tw_back=scion_boot</action>
					<action function="overlay">select_storage</action>
				</actions>
			</button>

			<action>
				<condition var1="tw_filename" op="modified"/>
				<actions>
					<action function="set">tw_back=scion_boot</action>
					<action function="set">tw_action_text1=Write BOOT</action>
					<action function="set">tw_text1=%tw_file%</action>
					<action function="set">tw_text2=goes to BOOT, then is read back and compared</action>
					<action function="set">tw_text3=Nothing else is written.</action>
					<action function="set">tw_slider_text=Swipe to write BOOT</action>
					<action function="set">tw_action_param=/sbin/scion flash "%tw_filename%" BOOT</action>
					<action function="page">scion_confirm</action>
				</actions>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>
		<page name="scion_install">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>Install iOS</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>Writes USERDATA or BOOT, nothing else</text>
			</text>

			<listbox style="advanced_listbox">
				<placement x="%indent%" y="%scion_list_y%" w="%content_width%" h="%scion_list_h%"/>

				<listitem name="iOS root image to USERDATA (SD card or USB)">
					<actions>
						<action function="set">tw_scion_pick=write</action>
						<action function="page">scion_pick_root</action>
					</actions>
				</listitem>
				<listitem name="Boot image to BOOT">
					<actions>
						<action function="page">scion_boot</action>
					</actions>
				</listitem>
				<listitem name="Installer zip (iOS 16.5): TWRP's Install">
					<actions>
						<action function="queueclear"></action>
						<action function="set">tw_selectimage=0</action>
						<action function="page">install</action>
					</actions>
				</listitem>
				<listitem name="Root or boot image from a computer: fastboot">
					<actions>
						<action function="page">scion_fastboot</action>
					</actions>
				</listitem>

				<listitem name="Installer zip from a computer: ADB sideload">
					<actions>
						<action function="page">sideload</action>
					</actions>
				</listitem>
			</listbox>

			<text style="text_s">
				<placement x="%indent%" y="%scion_note1_y%"/>
				<text>A root image is too big for internal storage.</text>
			</text>

			<text style="text_s">
				<placement x="%indent%" y="%scion_note2_y%"/>
				<text>Use exFAT on the SD card or USB (FAT32: 4 GiB max).</text>
			</text>

			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="scion_switch">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>Switch system</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>Chooses what BOOT starts</text>
			</text>

			<listbox style="advanced_listbox">
				<placement x="%indent%" y="%scion_list_y%" w="%content_width%" h="%scion_list_h%"/>

				<listitem name="Start Android next">
					<actions>
						<action function="set">tw_back=scion_switch</action>
						<action function="set">tw_action_text1=Switch to Android</action>
						<action function="set">tw_text1=scion/boot-android.img goes to BOOT</action>
						<action function="set">tw_text2=BOOT only; checked against its .sha256 first</action>
						<action function="set">tw_text3=USERDATA is checked, not written</action>
						<action function="set">tw_slider_text=Swipe to switch to Android</action>
						<action function="set">tw_action_param=/sbin/scion switch android</action>
						<action function="page">scion_confirm</action>
					</actions>
				</listitem>
				<listitem name="Start iOS 16.5 next">
					<actions>
						<action function="set">tw_back=scion_switch</action>
						<action function="set">tw_action_text1=Switch to iOS 16.5</action>
						<action function="set">tw_text1=scion/boot-ios165.img goes to BOOT</action>
						<action function="set">tw_text2=BOOT only; checked against its .sha256 first</action>
						<action function="set">tw_text3=USERDATA is checked, not written</action>
						<action function="set">tw_slider_text=Swipe to switch to iOS 16.5</action>
						<action function="set">tw_action_param=/sbin/scion switch ios165</action>
						<action function="page">scion_confirm</action>
					</actions>
				</listitem>
				<listitem name="Start iOS 27 next">
					<actions>
						<action function="set">tw_back=scion_switch</action>
						<action function="set">tw_action_text1=Switch to iOS 27</action>
						<action function="set">tw_text1=scion/boot-ios27.img goes to BOOT</action>
						<action function="set">tw_text2=BOOT only; checked against its .sha256 first</action>
						<action function="set">tw_text3=USERDATA is checked, not written</action>
						<action function="set">tw_slider_text=Swipe to switch to iOS 27</action>
						<action function="set">tw_action_param=/sbin/scion switch ios27</action>
						<action function="page">scion_confirm</action>
					</actions>
				</listitem>
				<listitem name="Show the boot library">
					<actions>
						<action function="set">tw_back=scion_switch</action>
						<action function="set">tw_action_text1=Boot library</action>
						<action function="set">tw_action_param=/sbin/scion bootlib</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
				<listitem name="Save BOOT now as Android's">
					<actions>
						<action function="set">tw_back=scion_switch</action>
						<action function="set">tw_action_text1=Save BOOT as Android's</action>
						<action function="set">tw_action_param=/sbin/scion bootlib save android</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
				<listitem name="Save BOOT now as iOS 16.5's">
					<actions>
						<action function="set">tw_back=scion_switch</action>
						<action function="set">tw_action_text1=Save BOOT as iOS 16.5's</action>
						<action function="set">tw_action_param=/sbin/scion bootlib save ios165</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
				<listitem name="Save BOOT now as iOS 27's">
					<actions>
						<action function="set">tw_back=scion_switch</action>
						<action function="set">tw_action_text1=Save BOOT as iOS 27's</action>
						<action function="set">tw_action_param=/sbin/scion bootlib save ios27</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
			</listbox>

			<text style="text_s">
				<placement x="%indent%" y="%scion_note1_y%"/>
				<text>Boot images: scion/ on the SD card or USB, each</text>
			</text>

			<text style="text_s">
				<placement x="%indent%" y="%scion_note2_y%"/>
				<text>with a .sha256: boot-android, -ios165, -ios27.img</text>
			</text>

			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="scion_backup">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>Back up and restore</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>Copies go to the SD card or USB drive</text>
			</text>

			<listbox style="advanced_listbox">
				<placement x="%indent%" y="%scion_list_y%" w="%content_width%" h="%scion_list_h%"/>

				<listitem name="Back up the iOS root or var (USERDATA)">
					<actions>
						<action function="set">tw_back=scion_backup</action>
						<action function="set">tw_action_text1=Back up USERDATA</action>
						<action function="set">tw_action_param=/sbin/scion backup-root</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
				<listitem name="Restore the iOS root (needs its .sha256)">
					<actions>
						<action function="set">tw_scion_pick=restore</action>
						<action function="page">scion_pick_root</action>
					</actions>
				</listitem>
				<listitem name="Back up BOOT">
					<actions>
						<action function="set">tw_back=scion_backup</action>
						<action function="set">tw_action_text1=Back up BOOT</action>
						<action function="set">tw_action_param=/sbin/scion backup-boot</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
				<listitem name="Copy EFS, SEC_EFS, CPEFS (read only)">
					<actions>
						<action function="set">tw_back=scion_backup</action>
						<action function="set">tw_action_text1=Copy EFS</action>
						<action function="set">tw_action_param=/sbin/scion copy-efs</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
			</listbox>

			<text style="text_s">
				<placement x="%indent%" y="%scion_note1_y%"/>
				<text>Every copy is read back and gets a .sha256.</text>
			</text>

			<text style="text_s">
				<placement x="%indent%" y="%scion_note2_y%"/>
				<text>EFS is only read. Its copy is the phone's identity.</text>
			</text>

			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="scion_fastboot">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>Fastboot</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>From a computer, over USB, instead of adb</text>
			</text>

			<listbox style="advanced_listbox">
				<placement x="%indent%" y="%scion_list_y%" w="%content_width%" h="%scion_fb_list_h%"/>

				<listitem name="Start fastboot (adb stops)">
					<actions>
						<action function="set">tw_back=scion_fastboot</action>
						<action function="set">tw_action_text1=Start fastboot</action>
						<action function="set">tw_action_param=/sbin/scion fastboot start</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>

				<listitem name="Stop fastboot (adb comes back)">
					<actions>
						<action function="set">tw_back=scion_fastboot</action>
						<action function="set">tw_action_text1=Stop fastboot</action>
						<action function="set">tw_action_param=/sbin/scion fastboot stop</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>

				<listitem name="Status and log">
					<actions>
						<action function="set">tw_back=scion_fastboot</action>
						<action function="set">tw_action_text1=Fastboot status</action>
						<action function="set">tw_action_param=/sbin/scion fastboot status</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
			</listbox>

			<text style="text_s">
				<placement x="%indent%" y="%scion_fb_text1_y%"/>
				<text>fastboot flash boot BOOT.img</text>
			</text>

			<text style="text_s">
				<placement x="%indent%" y="%scion_fb_text2_y%"/>
				<text>fastboot flash userdata ROOT.img (erases Android's data)</text>
			</text>

			<text style="text_s">
				<placement x="%indent%" y="%scion_fb_text3_y%"/>
				<text>fastboot reboot bootloader = Download mode</text>
			</text>

			<text style="text_s">
				<placement x="%indent%" y="%scion_fb_text4_y%"/>
				<text>BOOT and USERDATA only; every write is read back.</text>
			</text>

			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="scion_settings">
			<template name="page"/>

			<text style="text_l">
				<placement x="%col1_x_header%" y="%row3_header_y%"/>
				<text>Scion settings</text>
			</text>

			<text style="text_m">
				<placement x="%col1_x_header%" y="%row4_header_y%"/>
				<text>What Scion may write</text>
			</text>

			<checkbox>
				<placement x="%indent%" y="%scion_list_y%"/>
				<text>Advanced: TWRP's Install Image (BOOT only)</text>
				<data variable="tw_scion_advanced"/>
			</checkbox>

			<listbox style="advanced_listbox">
				<placement x="%indent%" y="%scion_list2_y%" w="%content_width%" h="%scion_list2_h%"/>

				<listitem name="Show the write policy">
					<actions>
						<action function="set">tw_back=scion_settings</action>
						<action function="set">tw_action_text1=Write policy</action>
						<action function="set">tw_action_param=/sbin/scion policy</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
				<listitem name="Show the log of writes">
					<actions>
						<action function="set">tw_back=scion_settings</action>
						<action function="set">tw_action_text1=Log of writes</action>
						<action function="set">tw_action_param=cat /tmp/scion-actions.log</action>
						<action function="page">scion_go</action>
					</actions>
				</listitem>
			</listbox>

			<text style="text_s">
				<placement x="%indent%" y="%scion_note1_y%"/>
				<text>Scion writes BOOT and USERDATA only. EFS, modem,</text>
			</text>

			<text style="text_s">
				<placement x="%indent%" y="%scion_note2_y%"/>
				<text>boot loader, RPMB: not in TWRP's fstab either.</text>
			</text>

			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

	</pages>
</recovery>
